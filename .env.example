JWT_SECRET_KEY=
MONGO_URI=
MONGO_DB_NAME=controlempleados
CORS_ALLOWED_ORIGINS=https://cibercomrh.com
PUBLIC_REGISTRATION_ENABLED=false

# Aegis existente
AEGIS_BASE_URL=
AEGIS_TENANT_ID=cibercom
AEGIS_APP_ID=empleados
AEGIS_API_KEY=
# La clave pertenece solo a AEGIS_TENANT_ID. Otro X-Tenant-Id no amplía su alcance.
# No usar principal ni sistemaempleados. AEGIS_LEGACY_LOGIN_FALLBACK se ignora.
AEGIS_ACCESS_CACHE_SECONDS=60
COOKIE_SAMESITE=Lax
# COOKIE_SECURE=true cuando el sitio se sirve por HTTPS
TRUSTED_PROXY_HOPS=0
# Si se define, la solicitud de acceso deja un aviso en el outbox. No se envía solo.
ACCESS_REQUEST_NOTIFY_EMAIL=

# El registro público sólo debe activarse cuando exista un TenantProvisioner
# conectado al contrato real de aprovisionamiento de Aegis.
# Origen público usado en correos y ligas por empresa.
PUBLIC_APP_URL=https://cibercomrh.com
