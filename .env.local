# .env.local — NO subir a git. Agrega esta línea a tu .gitignore:
#   .env.local
#
# Este backend no carga .env automáticamente por sí solo; app.py ya trae
# una carga opcional de python-dotenv (ver más abajo). Si prefieres no usar
# dotenv, exporta estas mismas variables en tu shell o en la config de tu
# proceso (systemd, Docker, etc.) antes de correr `python app.py`.

# ─── Mongo ───────────────────────────────────────────────────────────────
# Completa esto SOLO después de rotar la contraseña en MongoDB Atlas.
MONGO_URI=mongodb+srv://cibercom:proyectos2022@cluster0.ilngp.mongodb.net/controlempleados?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=2769f60cafc5203750cf162dbe61e7f26c29e4c0763c35d7790ce98e59ff3f5a

# ─── Aegis ───────────────────────────────────────────────────────────────
# Faltan estos tres para que el login delegue en Aegis (login_enabled=True).
AEGIS_BASE_URL=https://aegis.redcibercom.cloud
AEGIS_TENANT_ID=cibercom
AEGIS_APP_ID=principal
AEGIS_API_KEY=ak_test_HZYDddSs0GOARDw_jR8YirPSQTcUL8Mv6Gk9vAGFtkU

# ─── Opcionales ──────────────────────────────────────────────────────────
# Si la dejas vacía, se genera una contraseña aleatoria para el super admin
# y se imprime UNA vez en los logs al arrancar.
SUPER_ADMIN_INITIAL_PASSWORD=

# Cambiar a tu dominio real de frontend antes de producción (no "*").
CORS_ALLOWED_ORIGINS=*

FLASK_DEBUG=false
